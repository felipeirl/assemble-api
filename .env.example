# Copie para .env (ignorado pelo git) e preencha. Nunca commite valores reais.
# Linhas deixadas em branco são ignoradas (valem os padrões de app/config.py).

# --- Obrigatória: sem ela o servidor não sobe ---------------------------------------------
# Conteúdo do JSON da conta de serviço do Firebase, em UMA linha e entre aspas simples:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Jobs (/jobs/*): sem JOBS_KEY todas as rotas de job respondem 401 -----------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBS_KEY=

# --- Catálogo: sem a chave, /jobs/ingest responde 503 --------------------------------------
COMICVINE_API_KEY=

# --- IA (Command Code): sem estas, o chat, o match e /jobs/personas respondem 503 ----------
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
# Ids de GET <COMMANDCODE_BASE_URL>/models (ex.: qwen/qwen3.7-flash)
CHAT_MODEL=
CHAT_FALLBACK_MODEL=
PERSONA_MODEL=

DEFAULT_TIMEZONE=America/Sao_Paulo

# --- Opcionais (valores padrão mostrados) ---------------------------------------------------
# GUARDRAIL_ENABLED=true            # false desliga o Laya (sem guardrail nem afinidade)
# GUARDRAIL_THRESHOLD=0.5
# MATCH_WEIGHT_COMPATIBILITY=0.6
# MATCH_WEIGHT_AFFINITY=0.3
# MATCH_WEIGHT_CHANCE=0.1
# MATCH_CUTOFF=0.55
# DECK_SIZE=30
# CATALOG_CACHE_SECONDS=600
# MESSAGES_PER_HOUR=60
# CHAT_HISTORY_LIMIT=20
# LLM_TIMEOUT_SECONDS=30
# PERSONA_BATCH_SIZE=20
# TIER_B_MIN_APPEARANCES=50
# INGEST_MAX_REQUESTS_PER_RESOURCE=190
# INGEST_REQUEST_INTERVAL_SECONDS=1.0
# INGEST_REFRESH_DAYS=30
# BIO_MAX_CHARS=2000
# PERSONALITY_MAX_CHARS=2000
