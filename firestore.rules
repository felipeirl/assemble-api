rules_version = '2';

// Assemble — regras do Firestore.
// O backend usa o Admin SDK e ignora estas regras; elas valem só para o app.
// Leitura: o dono lê o próprio users/{uid} e subcoleções.
// Escrita do app: perfil (com a foto e a frase lookingFor), preferências e aiConsent em users/{uid};
// lastReadAt e profileUnlockSeenAt em matches/*. Todo o resto é negado.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Conta em carência ("Delete account"): dados fora de uso até reativar ou apagar.
    function isDeactivated(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) && get(path).data.get('status', 'active') == 'deactivated';
    }

    function profileFields() {
      return ['displayName', 'bio', 'avatarPreset', 'avatarPhoto', 'profileStyle', 'createdAt',
              'onboardingCompletedAt', 'preferences', 'aiConsent', 'lookingFor'];
    }

    function enumList(values, allowed) {
      return values is list
        && values.size() <= allowed.size()
        && values.toSet().size() == values.size()
        && allowed.hasAll(values);
    }

    function validPreferences(p) {
      return p is map
        && p.keys().hasOnly(['origins', 'powers', 'teams', 'styles', 'fame'])
        && (!('origins' in p) || enumList(p.origins,
              ['Human', 'Mutant', 'Alien', 'Robot', 'Radiation', 'GodEternal',
               'Animal', 'Cosmic', 'Infection', 'Other']))
        && (!('powers' in p) || enumList(p.powers,
              ['Strength', 'Flight', 'Speed', 'Mind', 'Energy', 'Magic',
               'AgilityCombat', 'Healing', 'Shapeshifting', 'TechGadgets']))
        && (!('teams' in p) || enumList(p.teams,
              ['Avengers', 'XMen', 'FantasticFour', 'Guardians', 'Shield',
               'Defenders', 'Solo']))
        && (!('styles' in p) || enumList(p.styles,
              ['Science', 'Humor', 'Leadership', 'Loner', 'Dark', 'Idealist',
               'Rebel', 'Strategist']))
        && (!('fame' in p) || (p.fame is number && p.fame >= 0 && p.fame <= 1));
    }

    // Até 3 strings; as regras não iteram listas, por isso cada posição é checada.
    function shortStringList(values) {
      return values is list
        && values.size() <= 3
        && (values.size() < 1 || (values[0] is string && values[0].size() <= 200))
        && (values.size() < 2 || (values[1] is string && values[1].size() <= 200))
        && (values.size() < 3 || (values[2] is string && values[2].size() <= 200));
    }

    // Perfil personalizável (Assemble-perfis-e-fontes.md §1). Moldura bloqueada e destaques
    // inválidos não são barrados aqui: o app limpa na exibição (o perfil só é visto pelo dono).
    function validProfileStyle(s) {
      return s is map
        && s.keys().hasOnly(['cover', 'accent', 'frame', 'prompt', 'promptAnswer',
                             'featuredConnections', 'featuredBadges', 'title'])
        && (!('cover' in s) || s.cover in ['Energy', 'Halftone', 'Comic', 'Night',
                                            'Headline', 'Blueprint', 'Cosmos'])
        && (!('accent' in s) || s.accent in ['Pink', 'Red', 'Blue', 'Violet', 'Gold',
                                              'Emerald', 'Silver'])
        && (!('frame' in s) || s.frame in ['Simple', 'Ring', 'Hexagon', 'Burst',
                                            'Shield', 'Cosmic', 'Lightning'])
        // Sem título, o app não grava o campo (apaga ao tirar): nunca chega null.
        && (!('title' in s) || s.title in ['Recruit', 'IceBreaker', 'Explorer', 'Diplomat',
                                            'LivingLegend', 'AlterEgo'])
        && (!('prompt' in s) || s.prompt in ['DreamPower', 'IdealTeam', 'FirstRecruit'])
        && (!('promptAnswer' in s)
              || (s.promptAnswer is string && s.promptAnswer.size() <= 80))
        && (!('featuredConnections' in s) || shortStringList(s.featuredConnections))
        && (!('featuredBadges' in s)
              || (s.featuredBadges is list && s.featuredBadges.size() <= 3
                  && enumList(s.featuredBadges,
                       ['FirstConnection', 'TeamUp', 'FullRoster', 'Legion',
                        'IceBreaker', 'RoundOfIntros', 'Storyteller', 'Diplomat', 'Veteran',
                        'Explorer', 'Scout', 'Cartographer', 'Crossover', 'Multiverse',
                        'SecretIdentity', 'Sentinel'])));
    }

    function validAiConsent(c) {
      return c is map
        && c.keys().hasOnly(['acceptedAt', 'version'])
        && c.acceptedAt is timestamp
        && c.version is string && c.version.size() <= 20;
    }

    // JPEG de 256 px em Base64 (uns 30 mil caracteres) ou URL de imagem do Cloudinary.
    function validAvatarPhoto(photo) {
      return photo is string && photo.size() <= 120000
        && (photo.matches('https://res[.]cloudinary[.]com/.*') || !photo.matches('(?i)https?://.*'));
    }

    // Valida só os campos presentes no documento resultante.
    function validProfile(d) {
      return (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 60))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 500))
        && (!('lookingFor' in d) || (d.lookingFor is string && d.lookingFor.size() <= 140))
        && (!('avatarPreset' in d)
              || (d.avatarPreset is int && d.avatarPreset >= 0 && d.avatarPreset <= 5))
        // Foto: URL do Cloudinary (res.cloudinary.com) ou o JPEG em Base64 de antes.
        && (!('avatarPhoto' in d) || validAvatarPhoto(d.avatarPhoto))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('onboardingCompletedAt' in d) || d.onboardingCompletedAt is timestamp)
        && (!('profileStyle' in d) || validProfileStyle(d.profileStyle))
        && (!('preferences' in d) || validPreferences(d.preferences))
        && (!('aiConsent' in d) || validAiConsent(d.aiConsent));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileFields())
        && validProfile(request.resource.data);

      // status e deactivatedAt são do backend: o app nunca os altera.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        && validProfile(request.resource.data);

      // Leitura das subcoleções (decisions, matches, messages, decks, tasteSignals), só com conta ativa.
      match /{subcollection=**} {
        allow read: if isOwner(uid) && !isDeactivated(uid);
      }

      match /matches/{characterId} {
        allow update: if isOwner(uid) && !isDeactivated(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastReadAt', 'profileUnlockSeenAt'])
          && (!('lastReadAt' in request.resource.data)
                || request.resource.data.lastReadAt is timestamp)
          && (!('profileUnlockSeenAt' in request.resource.data)
                || request.resource.data.profileUnlockSeenAt is timestamp);
      }
    }

    // characters, personas, accessLogs e qualquer outro caminho: sem acesso do app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
